                " Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers, {{\"dt\", type date}, {\"weekday\", Int64.Type}, {\"weekday_name\", type text}, {\"month\", type text}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
